# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/flamex
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/flamex?retryWrites=true&w=majority

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d
ENCRYPTION_KEY=your-32-char-encryption-key!

# API Keys (Add your own)
# Jupiter API (for Solana swaps)
JUPITER_API_URL=https://quote-api.jup.ag/v6

# LI.FI API (for cross-chain swaps)
LIFI_API_URL=https://li.quest/v1
LIFI_API_KEY=your_lifi_api_key

# Yellow Card API (for NGN fiat)
YELLOW_CARD_API_URL=https://api.yellowcard.io
YELLOW_CARD_API_KEY=your_yellowcard_api_key
YELLOW_CARD_SECRET=your_yellowcard_secret

# Alchemy/Infura (for EVM chains)
ALCHEMY_API_KEY=your_alchemy_api_key
INFURA_API_KEY=your_infura_api_key

# Solana RPC
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Or use QuickNode/Alchemy:
# SOLANA_RPC_URL=https://your-solana-node.quicknode.pro/your-api-key

# EVM RPC URLs
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-api-key
BSC_RPC_URL=https://bsc-dataseed.binance.org
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/your-api-key
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/your-api-key
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/your-api-key

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=FlameX <no-reply@flamex.app>

# App URLs
APP_URL=https://flamex.app
API_URL=https://api.flamex.app
FRONTEND_URL=http://localhost:8081
ADMIN_FRONTEND_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# CRYPTO WALLET & BLOCKCHAIN SERVICES
# ============================================

# Thirdweb - Non-Custodial Wallet & Smart Accounts
# Get your API keys at: https://portal.thirdweb.com/
THIRDWEB_SECRET_KEY=your_thirdweb_secret_key
THIRDWEB_CLIENT_ID=your_thirdweb_client_id

# Alchemy - Blockchain Node Provider
# Get your API keys at: https://dashboard.alchemy.com/
ALCHEMY_API_KEY=your_alchemy_api_key

# LI.FI - Cross-Chain Swaps & Bridges
# Get your API keys at: https://dashboard.li.fi/
LIFI_API_KEY=your_lifi_api_key

# ============================================
# FIAT PAYMENT SERVICES (Nigeria)
# ============================================

# Monnify - NGN Virtual Accounts & Bank Transfers
# Get your API keys at: https://app.monnify.com/
MONNIFY_API_KEY=your_monnify_api_key
MONNIFY_CONTRACT_CODE=your_monnify_contract_code
MONNIFY_SECRET_KEY=your_monnify_secret_key

# Flutterwave - Card Payments & Virtual Cards
# Get your API keys at: https://dashboard.flutterwave.com/
FLUTTERWAVE_PUBLIC_KEY=your_flutterwave_public_key
FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret_key
FLUTTERWAVE_ENCRYPTION_KEY=your_flutterwave_encryption_key

# ============================================
# KYC & COMPLIANCE
# ============================================

# Dojah - BVN & Identity Verification
# Get your API keys at: https://dashboard.dojah.io/
DOJAH_APP_ID=your_dojah_app_id
DOJAH_API_KEY=your_dojah_api_key
DOJAH_WEBHOOK_SECRET=your_dojah_webhook_secret

# ============================================
# BILL PAYMENTS
# ============================================

# VTpass - Airtime, Data, Utilities
# Get your API keys at: https://vtpass.com/
VTPASS_EMAIL=your_vtpass_email
VTPASS_PASSWORD=your_vtpass_password
VTPASS_SERVICE_ID=your_vtpass_service_id

# ============================================
# P2P MARKETPLACE
# ============================================

# Admin dashboard access
ADMIN_EMAILS=admin@flamex.app

# Comma-separated admin emails allowed to resolve P2P disputes
P2P_ADMIN_EMAILS=admin@flamex.app

# P2P platform commission rates
P2P_CRYPTO_FEE_RATE=0.0025
P2P_NGN_FEE_RATE=0

# ============================================
# GIFT CARDS
# ============================================

# Manual gift card trading starts with admin-reviewed trades.
# Configure gift card rates from the admin dashboard.
