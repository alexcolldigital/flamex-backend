{
  "name": "flamex-backend",
  "version": "1.0.0",
  "description": "FlameX Multi-Chain Crypto Wallet Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "prod": "NODE_ENV=production node server.js",
    "prod:pm2": "pm2 start server.js --name flamex-api --env production",
    "lint": "eslint .",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "staging:smoke": "node scripts/staging-smoke.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js"
  },
  "keywords": ["crypto", "wallet", "blockchain", "web3"],
  "author": "FlameX Team",
  "license": "ISC",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "@lifi/sdk": "^3.16.3",
    "@thirdweb-dev/sdk": "^4.0.99",
    "alchemy-sdk": "^3.6.5",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "nodemailer": "^8.0.7",
    "redis": "^4.6.10",
    "uuid": "^14.0.0",
    "compression": "^1.7.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "pm2": "^5.3.0"
  }
}

